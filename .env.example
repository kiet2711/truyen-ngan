# Cổng khởi chạy máy chủ (Mặc định: 3000)
PORT=3000

# Chuỗi kết nối Database Neon PostgreSQL Serverless (Free)
# Lấy từ Dashboard Neon của bạn: https://console.neon.tech/ -> Chọn Database -> Connection Details
# Ví dụ: postgresql://neondb_owner:npg_xyz123@ep-cool-fog-a1b2c3d4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/neondb?sslmode=require

# Tài khoản Admin mặc định khi khởi tạo hệ thống lần đầu
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@novels.ai
ADMIN_PASSWORD=admin
